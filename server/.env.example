MONGODB_URI=mongodb://localhost:27017/pumpstation
PORT=3001

# Origins permitted to call this API. Comma-separated, no trailing slash.
# EMPTY DENIES ALL cross-origin requests — that is deliberate. The previous
# server called cors() with no arguments, which reflected any origin.
ALLOWED_ORIGINS=http://localhost:3001

# Bound into every signed message. A signature issued for one domain is
# worthless on another, so this must match the origin users actually visit.
AUTH_DOMAIN=localhost:3001
AUTH_URI=http://localhost:3001

# Bound into the signed message. 1 = Ethereum mainnet.
CHAIN_ID=1
