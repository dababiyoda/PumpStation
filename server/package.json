{
  "name": "pumpstation-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulation-only PumpStation community capital research institution",
  "main": "dist/src/index.js",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:negative": "node --import tsx --test test/required-negative.test.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "experiment": "node --import tsx scripts/run-experiment.ts",
    "experiment:v2": "node --import tsx scripts/run-experiment-v2.ts",
    "experiment:all": "npm run experiment && npm run experiment:v2",
    "security:surfaces": "node --import tsx scripts/check-prohibited-surfaces.ts",
    "security:audit": "npm audit --audit-level=high",
    "check": "npm run format:check && npm run typecheck && npm test && npm run security:surfaces"
  }
}
